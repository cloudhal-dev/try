{
  "name": "cloudhal-try",
  "private": true,
  "version": "0.0.0",
  "description": "try.cloudhal.com: a disposable Cloudhal per visitor (RFC-0036)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/copy-studio.mjs && astro build",
    "dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "demo-media": "node scripts/demo-media.mjs",
    "typecheck": "astro sync && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test test/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@cloudhal/astro-renderer": "0.6.2",
    "@cloudhal/cli": "0.6.2",
    "@cloudhal/cloudflare": "0.6.2",
    "@cloudhal/core-contracts": "0.6.2",
    "@cloudhal/core-ts": "0.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261007.1",
    "typescript": "7.0.2",
    "wrangler": "4.148.0"
  }
}
