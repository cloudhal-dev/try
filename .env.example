# Copy to .dev.vars for `wrangler dev`. No real values belong in this file.

# Kill switch (RFC-0036 §7): "false" serves only the landing page.
PLAYGROUND_ENABLED=false

# Daily session cap (RFC-0036 §9); empty means no cap.
PLAYGROUND_DAILY_SESSIONS=

# Turnstile, only after a rate-limit hit (RFC-0036 §7). Set the secret with
# `wrangler secret put TURNSTILE_SECRET_KEY`, never here.
TURNSTILE_SITE_KEY=

# Deploy (CI only): a scoped Cloudflare API token, kept in GitHub secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
