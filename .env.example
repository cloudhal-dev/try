# Copy to .dev.vars for `pnpm dev` (wrangler dev). No real values belong in this file.

# Kill switch (RFC-0036 §7): only "true" opens the playground; wrangler.jsonc ships "false".
PLAYGROUND_ENABLED=true

# Signs the session cookie; at least 32 characters (e.g. `openssl rand -hex 32`).
# In production: `pnpm exec wrangler secret put PLAYGROUND_SECRET`.
PLAYGROUND_SECRET=

# New sessions per UTC day (RFC-0036 §9); empty means no cap.
PLAYGROUND_DAILY_SESSIONS=

# Turnstile, asked for only after a rate-limit hit (RFC-0036 §7). The secret goes in with
# `wrangler secret put TURNSTILE_SECRET`, never here.
TURNSTILE_SITE_KEY=
